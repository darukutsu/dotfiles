#!/bin/sh

show_help() {
  local name="$1"
  local usage="$2"
  local description="$3"
  local defaults="${4:-}"

  printf 'Usage: %s\n\n%s\n' "$usage" "$description"

  if [[ -n "$defaults" ]]; then
    printf '\nDefaults:\n%s\n' "$defaults"
  fi
}

# Extract audio → MP3
to_mp3() {
  if [[ $# -eq 0 || "$1" == "-h" || "$1" == "--help" ]]; then
    show_help "to_mp3" \
      "to_mp3 INPUT [OUTPUT.mp3]" \
      "Extract audio from a media file and encode it as MP3." \
      "OUTPUT defaults to INPUT without its extension + .mp3"
    return 0
  fi
  ffmpeg -i "$1" -vn -codec:a libmp3lame -q:a 2 "${2:-${1%.*}.mp3}"
}

# Extract audio → AAC
to_aac() {
  if [[ $# -eq 0 || "$1" == "-h" || "$1" == "--help" ]]; then
    show_help "to_aac" \
      "to_aac INPUT [OUTPUT.m4a]" \
      "Extract audio and encode it as AAC at 192 kbps." \
      "OUTPUT defaults to INPUT without its extension + .m4a"
    return 0
  fi
  ffmpeg -i "$1" -vn -codec:a aac -b:a 192k "${2:-${1%.*}.m4a}"
}

# Extract audio → FLAC
to_flac() {
  if [[ $# -eq 0 || "$1" == "-h" || "$1" == "--help" ]]; then
    show_help "to_flac" \
      "to_flac INPUT [OUTPUT.flac]" \
      "Extract audio and encode it as lossless FLAC." \
      "OUTPUT defaults to INPUT without its extension + .flac"
    return 0
  fi
  ffmpeg -i "$1" -vn -codec:a flac "${2:-${1%.*}.flac}"
}

# Video → MP4 (H.264)
to_mp4() {
  if [[ $# -eq 0 || "$1" == "-h" || "$1" == "--help" ]]; then
    show_help "to_mp4" \
      "to_mp4 INPUT [OUTPUT.mp4]" \
      "Convert video to MP4 using H.264 and AAC audio." \
      "Video CRF: 23; preset: medium; audio: 128 kbps"
    return 0
  fi
  ffmpeg -i "$1" -c:v libx264 -crf 23 -preset medium \
    -c:a aac -b:a 128k "${2:-${1%.*}.mp4}"
}

# Video → WebM (VP9)
to_webm() {
  if [[ $# -eq 0 || "$1" == "-h" || "$1" == "--help" ]]; then
    show_help "to_webm" \
      "to_webm INPUT [OUTPUT.webm]" \
      "Convert video to WebM using VP9 and Opus audio." \
      "Video CRF: 32; audio: 96 kbps"
    return 0
  fi
  ffmpeg -i "$1" -c:v libvpx-vp9 -crf 32 -b:v 0 \
    -c:a libopus -b:a 96k "${2:-${1%.*}.webm}"
}

# Video → WebM AV1
to_av1() {
  if [[ $# -eq 0 || "$1" == "-h" || "$1" == "--help" ]]; then
    show_help "to_av1" \
      "to_av1 INPUT [OUTPUT.webm]" \
      "Convert video to AV1 using SVT-AV1 and Opus audio." \
      "Video CRF: 35; preset: 6; audio: 96 kbps"
    return 0
  fi
  ffmpeg -i "$1" -c:v libsvtav1 -crf 35 -preset 6 \
    -c:a libopus -b:a 96k "${2:-${1%.*}.webm}"
}

# Video → GIF
to_gif() {
  if [[ $# -eq 0 || "$1" == "-h" || "$1" == "--help" ]]; then
    show_help "to_gif" \
      "to_gif INPUT [OUTPUT.gif]" \
      "Convert video to an animated GIF." \
      "Frame rate: 15 fps; width: 640 px"
    return 0
  fi
  ffmpeg -i "$1" -vf "fps=15,scale=640:-1:flags=lanczos" \
    "${2:-${1%.*}.gif}"
}

# Image → GIF (single frame)
to_gif_image() {
  if [[ $# -eq 0 || "$1" == "-h" || "$1" == "--help" ]]; then
    show_help "to_gif_image" \
      "to_gif_image INPUT [OUTPUT.gif]" \
      "Convert an image into a single-frame GIF." \
      "OUTPUT defaults to INPUT without its extension + .gif"
    return 0
  fi
  ffmpeg -i "$1" -frames:v 1 "${2:-${1%.*}.gif}"
}

# Video → animated WebP
to_webp() {
  if [[ $# -eq 0 || "$1" == "-h" || "$1" == "--help" ]]; then
    show_help "to_webp" \
      "to_webp INPUT [OUTPUT.webp]" \
      "Convert video to an animated WebP." \
      "Frame rate: 15 fps; width: 640 px; loops forever"
    return 0
  fi
  ffmpeg -i "$1" -vf "fps=15,scale=640:-1:flags=lanczos" \
    -c:v libwebp -loop 0 "${2:-${1%.*}.webp}"
}

# Video → thumbnail
to_thumb() {
  if [[ $# -eq 0 || "$1" == "-h" || "$1" == "--help" ]]; then
    show_help "to_thumb" \
      "to_thumb INPUT [TIME] [OUTPUT.jpg]" \
      "Extract a video frame as a JPEG thumbnail." \
      "TIME defaults to 00:00:01; OUTPUT defaults to INPUT without its extension + .jpg"
    return 0
  fi
  ffmpeg -i "$1" -ss "${2:-00:00:01}" -frames:v 1 \
    "${3:-${1%.*}.jpg}"
}

# Video → thumbnail WebP
to_thumb_webp() {
  if [[ $# -eq 0 || "$1" == "-h" || "$1" == "--help" ]]; then
    show_help "to_thumb_webp" \
      "to_thumb_webp INPUT [TIME] [OUTPUT.webp]" \
      "Extract a video frame as a WebP thumbnail." \
      "TIME defaults to 00:00:01; quality: 85"
    return 0
  fi
  ffmpeg -i "$1" -ss "${2:-00:00:01}" -frames:v 1 \
    -c:v libwebp -quality 85 "${3:-${1%.*}.webp}"
}

