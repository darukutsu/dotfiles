# Extract video only (copy stream)
ffmpeg_video_only() {
  if [[ $# -eq 0 || "$1" == "-h" || "$1" == "--help" ]]; then
    show_help "ffmpeg_video_only" \
      "ffmpeg_video_only INPUT [OUTPUT.mkv]" \
      "Copy the video stream without audio, without re-encoding."
    return 0
  fi
  ffmpeg -i "$1" -an -c:v copy "${2:-${1%.*}_video.mkv}"
}

# Extract audio only (copy stream)
ffmpeg_audio_only() {
  if [[ $# -eq 0 || "$1" == "-h" || "$1" == "--help" ]]; then
    show_help "ffmpeg_audio_only" \
      "ffmpeg_audio_only INPUT [OUTPUT.mka]" \
      "Copy the audio stream without re-encoding."
    return 0
  fi
  ffmpeg -i "$1" -vn -c:a copy "${2:-${1%.*}_audio.mka}"
}

# Remux without re-encoding
ffmpeg_remux() {
  if [[ $# -lt 2 || "$1" == "-h" || "$1" == "--help" ]]; then
    show_help "ffmpeg_remux" \
      "ffmpeg_remux INPUT OUTPUT" \
      "Change the container without re-encoding streams."
    return 0
  fi
  ffmpeg -i "$1" -map 0 -c copy "$2"
}

# Convert video using H.264/AAC
ffmpeg_convert_video() {
  if [[ $# -eq 0 || "$1" == "-h" || "$1" == "--help" ]]; then
    show_help "ffmpeg_convert_video" \
      "ffmpeg_convert_video INPUT [OUTPUT.mp4]" \
      "Convert video using H.264 video and AAC audio."
    return 0
  fi
  ffmpeg -i "$1" -c:v libx264 -c:a aac \
    "${2:-${1%.*}.mp4}"
}

# Pick a specific video stream
ffmpeg_pick_video() {
  if [[ $# -lt 2 || "$1" == "-h" || "$1" == "--help" ]]; then
    show_help "ffmpeg_pick_video" \
      "ffmpeg_pick_video INPUT OUTPUT [STREAM_INDEX]" \
      "Copy a selected video stream. Indexing starts at 0." \
      "STREAM_INDEX defaults to 0"
    return 0
  fi
  ffmpeg -i "$1" -map 0:v:"${3:-0}" -c copy "$2"
}

# Pick a specific audio stream
ffmpeg_pick_audio() {
  if [[ $# -lt 2 || "$1" == "-h" || "$1" == "--help" ]]; then
    show_help "ffmpeg_pick_audio" \
      "ffmpeg_pick_audio INPUT OUTPUT [STREAM_INDEX]" \
      "Copy a selected audio stream. Indexing starts at 0." \
      "STREAM_INDEX defaults to 0"
    return 0
  fi
  ffmpeg -i "$1" -map 0:a:"${3:-0}" -c copy "$2"
}

# Extract video range
ffmpeg_audio_range() {
  if [[ $# -lt 4 || "$1" == "-h" || "$1" == "--help" ]]; then
    show_help "ffmpeg_audio_range" \
      "ffmpeg_audio_range INPUT OUTPUT START DURATION [STREAM_INDEX]" \
      "Extract an audio segment. Converts to match the output format." \
      "START: start time; DURATION: length; STREAM_INDEX defaults to 0"
    return 0
  fi

  ffmpeg -ss "$3" -i "$1" -t "$4" \
    -map "0:a:${5:-0}" \
    -vn -c:a libmp3lame -q:a 2 "$2"
}

# Extract audio range
ffmpeg_audio_range() {
  if [[ $# -lt 4 || "$1" == "-h" || "$1" == "--help" ]]; then
    show_help "ffmpeg_audio_range" \
      "ffmpeg_audio_range INPUT OUTPUT START DURATION [STREAM_INDEX]" \
      "Extract an audio segment without re-encoding." \
      "STREAM_INDEX defaults to 0; START and DURATION use FFmpeg time syntax"
    return 0
  fi
  ffmpeg -ss "$3" -i "$1" -t "$4" -map 0:a:"${5:-0}" -c copy "$2"
}

