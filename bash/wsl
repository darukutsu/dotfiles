export PATH=/opt/clang/:${PATH}

# Remove Windows Python (scoop app + shims) from PATH — prevents VS Code Python extension
# from scanning Windows filesystem (~5 min startup delay)
PATH=$(echo "$PATH" | tr ':' '\n' | grep -v '/mnt/c/.*[Pp]ython\|/mnt/c/.*[Ss]coup.*[Pp]ython\|/mnt/c/Users/.*/scoop/shims' | tr '\n' ':' | sed 's/:$//')
export PATH
