{
  // around 8k context - default
  // around 44k context - with mcps
  // around 34k context - with mcphubonly
  // around 14k context - without mcps
  "$schema": "https://opencode.ai/config.json",
  "share": "disabled",
  "lsp": {
    // add here custom lsps...
  },
  "formatter": {
    // add here custom formatters for stuff like fstab...
  },
  "disabled_providers": [],
  // External programs that would be cool to integrate as plugin
  //"@th0rgal/ralph-wiggum"
  //"JuliusBrussee/caveman" -- git clone official repo and then install it manually however it mangles with comments
  //"graphifyy"
  //"darrenhinde/OpenAgentsControl" opencode-mem + oh-my-openagent simple-manual
  // https://github.com/Randroids-Dojo/ManageSkills
  // NOTE: opencode as of 1.18.23 doesn't have auto update mechanism,
  // manually remove cache and pin version
  "plugin": [
    // need better hardware or structure preplaned for these
    //"oh-my-openagent",
    //"oh-my-opencode-slim@latest", // simpler to setup
    "@tarquinen/opencode-dcp@3.1.15",
    //"opencode-notify", // disable once they create better internal notifier
    "opencode-ntfy.sh@1.1.0",
    "opencode-models-discovery@1.5.3", // remove this once opencode releases official local discovery
    //"opencode-mem", // interesting idea but not sure if worth
    "opencode-pty@0.3.6",
    //"opencode-skills-sync", # ai generated
    //"opencode-plugin-auto-update" // look for integrated solution
    //"@jfrog/opencode-jfrog-plugin@0.3.0", // causes duplication of .opencode
    //"opencode-firecrawl", // essentially same as mcp
    //"opencode-worktree" maybe if automation is preferred
    // NOTE: create/look4 skill/mcp/agent for citing
    //"opencode-websearch-cited@1.2.0", // trash because uses internal opencode search and not custom searxng
    "./plugins/caveman/plugin.js"
  ],
  "skillSources": [
    "https://github.com/mattpocock/skills"
    //"https://github.com/garrytan/gstack",
    //"https://github.com/mukul975/anthropic-cybersecurity-skills",
    //"https://github.com/anthropics/skills"
  ],
  // these skills must sit on disk somewhere
  //"skills": {
  //  "urls": [
  //    "https://github.com/mattpocock/skills",
  //    "https://github.com/garrytan/gstack",
  //    "https://github.com/mukul975/anthropic-cybersecurity-skills",
  //    "https://github.com/anthropics/skills"
  //  ]
  //},
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (local)",
      "options": {
        "baseURL": "http://ollama.ai.lan/v1",
        "modelsDiscovery": {
          "enabled": true,
          //see https://github.com/yuhp/opencode-models-discovery/blob/main/docs/configuration.md

          // NOTE: for versions older than 0.9
          //"models": {
          //	"excludeRegex": [
          //		"qwen3-embedding"
          //	]
          //},

          "smartModelName": false
        }
      }
    },
    "hento": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "hento.org",
      "options": {
        // have to put it here because otherwise it won't recognize as provider
        "apiKey": "{env:HENTO_AI_API_KEY}",
        "baseURL": "https://ai.hento.org/v1",
        "modelsDiscovery": {
          "enabled": true,
          // NOTE doesn't seem to filter
          //"modelInfoFormat": "litellm",
          //"modelInfoEndpoint": "/v1/models/capabilities",
          //"filterNonChat": true,
          "smartModelName": false
        }
      }
    }
  },
  "mcp": {
    //"comfy": {
    //	"url": "https://cloud.comfy.org/mcp"
    //},
    //
    // NOTE doesn't seem to work, besides using other ai to reduce context not sure
    //"mcphub-smart": {
    //  "type": "remote",
    //  "url": "https://mcp.hento.org/mcp/$smart",
    //  "enabled": true
    //}
    "mcphub-firecrawl": {
      "type": "remote",
      "url": "https://mcp.hento.org/mcp/firecrawl",
      "enabled": true
    },
    "mcphub-searxng": {
      "type": "remote",
      "url": "https://mcp.hento.org/mcp/searxng",
      "enabled": false
    },
    "mcphub-libretranslate": {
      "type": "remote",
      "url": "https://mcp.hento.org/mcp/libretranslate",
      "enabled": false
    },
    "mcphub-context7": {
      "type": "remote",
      "url": "https://mcp.hento.org/mcp/context7",
      "enabled": true
    },
    "mcphub-whois": {
      "type": "remote",
      "url": "https://mcp.hento.org/mcp/whois-mcp",
      "enabled": false
    },
    "mcphub-mem": {
      "type": "remote",
      "url": "https://mcp.hento.org/mcp/basic-memory",
      "enabled": true
    },
    "mcphub-diff": {
      "type": "remote",
      "url": "https://mcp.hento.org/mcp/diff-mcp",
      "enabled": false
    },
    "mcphub-kubernetes": {
      "type": "remote",
      "url": "https://mcp.hento.org/mcp/kubernetes",
      "enabled": false
    },
    "mcphub-neovim": {
      "type": "remote",
      "url": "https://mcp.hento.org/mcp/nvim",
      //"headers": {
      //  "Authorization": "Bearer {env:SOME_API_TOKEN}"
      //},
      "enabled": false
    },
    "mcphub-blender": {
      "type": "remote",
      "url": "https://mcp.hento.org/mcp/blender",
      "enabled": false
    },
    "mcphub-playwright": {
      "type": "remote",
      "url": "https://mcp.hento.org/mcp/playwright",
      "enabled": false
    },
    //"github": {
    //  "type": "remote",
    //  "url": "https://api.githubcopilot.com/mcp/",
    //  "oauth": false,
    //  "headers": {
    //    "Authorization": "Bearer YOUR_GITHUB_PAT"
    //  }
    //},
    "cloudflare": {
      "type": "remote",
      "url": "https://mcp.cloudflare.com/mcp",
      "enabled": false,
      // cloudflare doesn't support header bearer token
      "oauth": {}
    },
    "cloudflare-docs": {
      "type": "remote",
      "url": "https://docs.mcp.cloudflare.com/mcp",
      "enabled": false
    },
    "cloudflare-bindings": {
      "type": "remote",
      "url": "https://bindings.mcp.cloudflare.com/mcp",
      "enabled": false,
      "oauth": {}
    },
    "cloudflare-builds": {
      "type": "remote",
      "url": "https://builds.mcp.cloudflare.com/mcp",
      "enabled": false,
      "oauth": {}
    },
    "cloudflare-observability": {
      "type": "remote",
      "url": "https://observability.mcp.cloudflare.com/mcp",
      "enabled": false,
      "oauth": {}
    }
  },
  // permissions are merged with global ones
  "agent": {
    "build": {
      "mode": "primary",
      "permission": {
        "edit": "allow"
      }
    },
    "plan": {
      "mode": "primary",
      "permission": {
        "edit": "deny",
        // TODO: why do i need to be verbose here?
        // Cannot mention variable @permission to inherit for shorter config.
        "bash": {
          "*": "ask",
          "awk *": "allow",
          "basename *": "allow",
          "cat *": "allow",
          "curl *": "allow",
          "cut *": "allow",
          "df *": "allow",
          "diff *": "allow",
          "dirname *": "allow",
          "echo *": "allow",
          "find *": "allow",
          "git diff *": "allow",
          "git log *": "allow",
          "git status *": "allow",
          "grep *": "allow",
          "head *": "allow",
          "ls *": "allow",
          "printf *": "allow",
          "seq *": "allow",
          "sleep *": "allow",
          "sort *": "allow",
          "tail *": "allow",
          "tr *": "allow",
          "wc *": "allow"
        }
      }
    },
    // NOTE: I should create specific subagents running on certain models
    // that will be specialized on tasks with skills and permissions
    // preferably small 7B and less. This way I can omit stuff like `amplifier`.
    // This way we can disable built in subagents and specify ours in /agents directory.
    //
    // NOTE: some repetitive tasks could be made into command instead of subagent,
    // but i find skill more suitable for this since llm can decide when to run it
    // Maybe have both.
    //
    // NOTE: custom agents doesn't seem to save context probably needs better setup
    // to strip default 8k
    //
    //"test": {
    //  "mode": "primary",
    //  "description": "Answer questions, use mcps if needed. Never use Webfetch",
    //  "disable": false
    //},
    "review": {
      "temperature": 0.2,
      "top_p": 1.0,
      //"model": "deepseek-coder",
      "description": "Reviews code for best practices and potential issues",
      "disable": true,
      "permission": {
        "edit": "ask"
      }
    }
  },
  "permission": {
    "*": "ask",
    "read": "allow",
    "edit": "ask", // all 3 edit, write, patch
    "bash": {
      "*": "ask",
      "awk *": "allow",
      "basename *": "allow",
      //"bash *": "allow",
      "cat *": "allow",
      "curl *": "allow",
      "cut *": "allow",
      "df *": "allow",
      "diff *": "allow",
      "dirname *": "allow",
      "echo *": "allow",
      "find *": "allow",
      "git diff *": "allow",
      "git log *": "allow",
      "git status *": "allow",
      "grep *": "allow",
      "head *": "allow",
      "ls *": "allow",
      "printf *": "allow",
      "sed *": "allow",
      "seq *": "allow",
      //"sh": "allow",
      "sleep *": "allow",
      "sort *": "allow",
      "tail *": "allow",
      "tr *": "allow",
      "wc *": "allow"
      //"xargs": "allow",
    },
    "grep": "allow",
    "glob": "allow",
    "list": "allow",
    "lsp": "allow",
    "skill": "allow",
    //"task": {},
    "todowrite": "allow",
    "webfetch": "allow",
    "question": "allow"
    // MCPs allows, doesn't do probably what i think it does
    //"libretranslate": "allow",
    //"searxng": "allow"
  },
  //"instructions": ["CONTRIBUTING.md", "some-general-stuff-i-can-reuse", "https://url..."],
  "references": {
    "nvim": {
      "path": "~/.config/nvim",
      "description": "nvim config path"
    },
    "opencode": {
      "path": "~/.config/opencode",
      "description": "opencode config path"
    },
    "cfg": {
      "path": "~/.config/",
      "description": "config path"
    }
  }
}
