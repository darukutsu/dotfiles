{
	"$schema": "https://opencode.ai/config.json",
	"lsp": true,
	"formatter": true,
	"disabled_providers": [],
	"plugin": [
		//"oh-my-openagent", // configure first
		"@tarquinen/opencode-dcp@latest",
		"opencode-notify",
		//remove this once opencode releases official local discovery
		"opencode-models-discovery"
		//"JuliusBrussee/caveman"
		//"github:JuliusBrussee/caveman"
		//"@juliusbrussee/caveman-code"
		//"opencode-pty",
		//"opencode-websearch-cited",
		//"opencode-jfrog-plugin",
		//"opencode-antigravity-auth",
		//"opencode-gemini-auth",
		//"opencode-firecrawl",
	],
	"provider": {
		// single model server, figure out deployment & distribution
		// benefit of huggingface models
		//"vllm": {
		//	"npm": "@ai-sdk/openai-compatible",
		//	"name": "vLLM (local)",
		//	"options": {
		//		"baseURL": "http://vllm.ai.lan/v1"
		//	}
		//},
		"ollama": {
			"npm": "@ai-sdk/openai-compatible",
			"name": "Ollama (local)",
			"options": {
				"baseURL": "http://ollama.ai.lan/v1",
				"modelsDiscovery": {
					"enabled": true,
					//see https://github.com/yuhp/opencode-models-discovery/blob/main/docs/configuration.md

					// NOTE: for versions older than 0.9
					//"models": {
					//	"excludeRegex": [
					//		"qwen3-embedding"
					//	]
					//},

					"smartModelName": false
				}
			}
		}
	},
	"mcp": {
		"LibreTranslate": {
			"type": "local",
			"command": ["npx", "-y", "@libretranslate/mcp"],
			"environment": {
				"LIBRETRANSLATE_API_URL": "https://translate.hento.org",
				"LIBRETRANSLATE_API_KEY": "your-api-key"
			}
		},
		"SearXNG": {
			"type": "local",
			"command": ["npx", "-y", "mcp-searxng"],
			"environment": {
				"SEARXNG_URL": "https://search.hento.org"
			}
		},
		"cloudflare": {
			"type": "remote",
			"url": "https://mcp.cloudflare.com/mcp",
			"enabled": true,
			"oauth": {}
		},
		"cloudflare-docs": {
			"type": "remote",
			"url": "https://docs.mcp.cloudflare.com/mcp",
			"enabled": true
		},
		"cloudflare-bindings": {
			"type": "remote",
			"url": "https://bindings.mcp.cloudflare.com/mcp",
			"enabled": true,
			"oauth": {}
		},
		"cloudflare-builds": {
			"type": "remote",
			"url": "https://builds.mcp.cloudflare.com/mcp",
			"enabled": true,
			"oauth": {}
		},
		"cloudflare-observability": {
			"type": "remote",
			"url": "https://observability.mcp.cloudflare.com/mcp",
			"enabled": true,
			"oauth": {}
		}
	},
	"agent": {
		"build": {
			"mode": "primary",
			"permission": {
				"read": "allow",
				"edit": "allow",
				"bash": {
					"*": "ask",
					"awk *": "allow",
					"basename *": "allow",
					//"bash *": "allow",
					"cat *": "allow",
					"cut *": "allow",
					"df *": "allow",
					"diff *": "allow",
					"dirname *": "allow",
					"echo *": "allow",
					"find *": "allow",
					"git diff *": "allow",
					"git log *": "allow",
					"git status *": "allow",
					"grep *": "allow",
					"head *": "allow",
					"ls *": "allow",
					"printf *": "allow",
					"sed *": "allow",
					"seq *": "allow",
					//"sh *": "allow",
					"sleep *": "allow",
					"sort *": "allow",
					"tail *": "allow",
					"tr *": "allow",
					"wc *": "allow"
					//"xargs *": "allow",
				},
				"grep": "allow",
				"glob": "allow",
				"list": "allow",
				"lsp": "allow",
				"question": "allow",
				"skill": "allow",
				"webfetch": "allow"
			}
		},
		"review": {
			"temperature": 0.2,
			//"model": "deepseek-coder",
			"description": "Reviews code for best practices and potential issues",
			"disable": true
		}
	},
	"permission": {
		"bash": {
			"*": "ask",
			"awk *": "allow",
			"basename *": "allow",
			//"bash *": "allow",
			"cat *": "allow",
			"curl *": "allow",
			"cut *": "allow",
			"df *": "allow",
			"diff *": "allow",
			"dirname *": "allow",
			"echo *": "allow",
			"find *": "allow",
			"git diff *": "allow",
			"git log *": "allow",
			"git status *": "allow",
			"grep *": "allow",
			"head *": "allow",
			"ls *": "allow",
			"printf *": "allow",
			"sed *": "allow",
			"seq *": "allow",
			//"sh": "allow",
			"sleep *": "allow",
			"sort *": "allow",
			"tail *": "allow",
			"tr *": "allow"
			//"xargs": "allow",
		}
	},
	"references": {
		"nvim": {
			"path": "~/.config/nvim",
			"description": "nvim config path"
		}
	}
}
